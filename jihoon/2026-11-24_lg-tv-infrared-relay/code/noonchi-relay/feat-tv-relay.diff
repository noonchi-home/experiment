+// 서버 시작에서 가전 중계기 잇기: TV_RELAY_URL·TV_RELAY_TOKEN·TV_RELAY_DEVICE를 주면 그 기기를 relay 출처로 짝짓고,
+// 첫 읽기로 상태를 받고, 기기 명령 API가 중계기로 간다. 주지 않으면 그대로 가상이다. 실제 twin-studio 집(oneroom, TV tv_1)으로 돈다.
+import { createServer, type Server } from "node:http";
+import type { AddressInfo } from "node:net";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { fetchRetry } from "../src/shared/net.js";
+import { startServer, type RunningServer } from "../src/server/start.js";
+
+const TOKEN = "relay_token_for_tests_only";
+let srv: RunningServer | undefined;
+let relay: Server | undefined;
+const dirs: string[] = [];
+afterEach(async () => {
+  await srv?.close();
+  srv = undefined;
+  await new Promise<void>((ok) => (relay ? relay.close(() => ok()) : ok()));
+  relay = undefined;
+  for (const d of dirs.splice(0)) rmSync(d, { recursive: true, force: true });
+});
+
+async function fakeRelay() {
+  const state = { power: "on" as "on" | "off", commands: [] as string[] };
+  relay = createServer((req, res) => {
+    let raw = "";
+    req.on("data", (c) => (raw += c));
+    req.on("end", () => {
+      res.setHeader("content-type", "application/json");
+      if (req.headers.authorization !== `Bearer ${TOKEN}`) return res.writeHead(401).end("{}");
+      if (req.method === "GET" && req.url === "/api/devices/tv") return res.end(JSON.stringify({ power: state.power }));
+      if (req.method === "POST" && req.url === "/api/devices/tv/command") {
+        const { type } = JSON.parse(raw) as { type: "on" | "off" };
+        state.commands.push(type);
+        state.power = type;
+        return res.end(JSON.stringify({ ok: true, outcome: "done", power: type }));
+      }
+      res.writeHead(404).end("{}");
+    });
+  });
+  await new Promise<void>((ok) => relay!.listen(0, "127.0.0.1", ok));
+  return { url: `http://127.0.0.1:${(relay.address() as AddressInfo).port}`, state };
+}
+
+async function start(extra: Record<string, string>, logs: string[] = []) {
+  const dir = mkdtempSync(join(tmpdir(), "relay-server-"));
+  dirs.push(dir);
+  srv = await startServer({ env: { HUB: "memory", PORT: "0", HOME_ID: "oneroom", RUNTIME_DIR: dir, ...extra }, log: (l) => logs.push(l) });
+  return srv;
+}
