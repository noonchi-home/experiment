+//   GET  {TV_RELAY_URL}/api/devices/{기기}          → { power: "on"|"off"|"unknown", since, online }
+//   POST {TV_RELAY_URL}/api/devices/{기기}/command  { type: "on"|"off" } → { ok, outcome, power, error? }
+// 모든 요청에 Authorization: Bearer {TV_RELAY_TOKEN}. 응답이 없으면(시간 초과·연결 끊김) status 0.
+
+import { headWithin } from "../../shared/cut.js";
+
+/** 중계기가 본 상태. unknown: 중계기가 아직 TV 응답을 확인하지 못함. */
+export interface RelayState {
+  power: "on" | "off" | "unknown";
+  /** 마지막으로 바뀐 시각(ISO). */
+  since?: string | null;
+}
+
+/** 중계기 명령 결과. done: 다시 확인함, unverified: 쏘았지만 확인 안 됨, failed: 쏘지 못함, not_sent: 보내지 않음. */
+export interface RelayCommandResult {
+  ok: boolean;
+  outcome: "done" | "unverified" | "failed" | "not_sent";
+  power?: RelayState["power"];
+  error?: string;
+}
+
+export interface RelayConfig {
+  baseUrl: string;
+  token: string;
+  /** 중계기 쪽 기기 이름(경로의 {기기}). 기본 "tv". */
+  target: string;
+  /** 중계기와 짝지을 트윈 기기 id(TV_RELAY_DEVICE, 예: tv_living). */
+  deviceId: string;
+  /** 상태 읽기 한도(ms). */
+  timeoutMs: number;
+  /** 명령 한도(ms). 적외선 켜기는 TV 부팅(5~6초)·와이파이 확인까지 기다려서 길다. */
+  commandTimeoutMs: number;
+}
+
+export class RelayError extends Error {
+  constructor(message: string, readonly status: number) {
+    super(message);
+    this.name = "RelayError";
+  }
+}
+
+type Env = Record<string, string | undefined>;
+const DEFAULT_TIMEOUT_MS = 3000;
+const DEFAULT_COMMAND_TIMEOUT_MS = 45_000;
+
+/** TV_RELAY_URL이 없으면 { ok: false, off: true }(중계 안 씀). 있는데 틀리면 까닭. */
+export function relayConfig(env: Env): { ok: true; config: RelayConfig } | { ok: false; off: boolean; error: string } {
+  const url = env.TV_RELAY_URL?.trim();
+  if (!url) return { ok: false, off: true, error: "TV_RELAY_URL이 없어요." };
+  let parsed: URL;
+  try {
+    parsed = new URL(url);
+  } catch {
+    return { ok: false, off: false, error: `TV_RELAY_URL이 주소 모양이 아니에요: ${url}` };
+  }
+  if (parsed.protocol !== "http:" && parsed.protocol !== "https:") return { ok: false, off: false, error: "TV_RELAY_URL은 http 또는 https여야 해요." };
+  const token = env.TV_RELAY_TOKEN?.trim();
+  if (!token) return { ok: false, off: false, error: "TV_RELAY_TOKEN이 없어요(중계기와 같은 값)." };
+  const deviceId = env.TV_RELAY_DEVICE?.trim();
+  if (!deviceId) return { ok: false, off: false, error: "TV_RELAY_DEVICE가 없어요(짝지을 트윈 기기 id, 예: tv_living)." };
+  const ms = (raw: string | undefined, fallback: number) => {
+    const n = Number(raw);
+    return Number.isFinite(n) && n > 0 ? n : fallback;
+  };
+  return {
+    ok: true,
+    config: {
+      baseUrl: url.replace(/\/+$/, ""), token, target: env.TV_RELAY_TARGET?.trim() || "tv",
+      deviceId,
+      timeoutMs: ms(env.TV_RELAY_TIMEOUT_MS, DEFAULT_TIMEOUT_MS),
+      commandTimeoutMs: ms(env.TV_RELAY_COMMAND_TIMEOUT_MS, DEFAULT_COMMAND_TIMEOUT_MS),
+    },
+  };
+}
+
+export class RelayClient {
+  constructor(readonly config: RelayConfig) {}
+
+  async state(target = this.config.target): Promise<RelayState> {
+    const body = await this.request("GET", `/api/devices/${encodeURIComponent(target)}`, undefined, this.config.timeoutMs);
+    const power = (body as { power?: unknown }).power;
+    if (power !== "on" && power !== "off" && power !== "unknown") throw new RelayError(`중계기 답에 power가 없어요: ${JSON.stringify(body)}`, 200);
+    return { power, since: typeof (body as { since?: unknown }).since === "string" ? (body as { since: string }).since : null };
+  }
+
+  async command(type: "on" | "off", target = this.config.target): Promise<RelayCommandResult> {
+    const body = await this.request("POST", `/api/devices/${encodeURIComponent(target)}/command`, { type }, this.config.commandTimeoutMs) as Partial<RelayCommandResult>;
+    const outcome = body.outcome;
+    if (outcome !== "done" && outcome !== "unverified" && outcome !== "failed" && outcome !== "not_sent") {
+      throw new RelayError(`중계기 답에 outcome이 없어요: ${JSON.stringify(body)}`, 200);
+    }
+    return { ok: !!body.ok, outcome, power: body.power, error: body.error };
+  }
+
+  private async request(method: "GET" | "POST", path: string, body: unknown, timeoutMs: number): Promise<unknown> {
+    const ctrl = new AbortController();
+    const timer = setTimeout(() => ctrl.abort(), timeoutMs);
+    let res: Response;
+    try {
+      res = await fetch(this.config.baseUrl + path, {
+        method, signal: ctrl.signal,
+        headers: { authorization: `Bearer ${this.config.token}`, ...(body !== undefined ? { "content-type": "application/json" } : {}) },
+        body: body !== undefined ? JSON.stringify(body) : undefined,
+      });
+    } catch (e) {
+      throw new RelayError(ctrl.signal.aborted ? `중계기 응답이 ${timeoutMs}ms 안에 없어요.` : `중계기에 닿지 않아요: ${(e as Error).message}`, 0);
+    } finally {
+      clearTimeout(timer);
+    }
+    const text = await res.text();
+    let json: unknown = {};
+    try {
+      json = text ? JSON.parse(text) : {};
+    } catch {
+      throw new RelayError(`중계기 답이 JSON이 아니에요 (HTTP ${res.status})`, res.status);
+    }
+    // 409(앞 명령 처리 중)·400 같은 명령 결과도 본문에 outcome이 있으면 그대로 돌려준다
+    if (!res.ok && !(json && typeof json === "object" && "outcome" in json)) {
+      throw new RelayError(`중계기가 거절했어요 (HTTP ${res.status}): ${(json as { error?: string }).error ?? headWithin(text, 120)}`, res.status);
+    }
+    return json;
+  }
+}
